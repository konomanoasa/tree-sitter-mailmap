CompileFlags:
  Add:
    - -std=c17
    - -xc
    - -Wall
    - -Wextra
    - -Werror
    - -pedantic

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header

---
If:
  PathMatch: test/[^/]*\.c
CompileFlags:
  Add:
    - -ferror-limit=0

---
If:
  PathMatch: bindings/python/.*\.c
CompileFlags:
  CompilationDatabase: None
  Add:
    - -I../../src
