{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mailmap",
      "title": "Mailmap",
      "scope": "source.mailmap",
      "path": ".",
      "file-types": [".mailmap", "mailmap"],
      "injection-regex": "^mailmap$",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.6.1",
    "license": "MIT",
    "description": "Tree-sitter grammar for mailmap.",
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-mailmap"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false
  }
}
