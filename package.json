{
  "name": "@konomanoasa/tree-sitter-mailmap",
  "version": "0.6.0",
  "description": "Tree-sitter grammar for mailmap.",
  "license": "MIT",
  "repository": "git+https://github.com/konomanoasa/tree-sitter-mailmap.git",
  "type": "module",
  "exports": {
    ".": {
      "types": "./bindings/node/index.d.ts",
      "default": "./bindings/node/index.js"
    }
  },
  "files": [
    "Cargo.toml",
    "binding.gyp",
    "bindings/node/*.cc",
    "bindings/node/*.js",
    "bindings/node/*.ts",
    "bindings/python/*.c",
    "bindings/python/*.py",
    "bindings/python/*.pyi",
    "bindings/python/py.typed",
    "bindings/rust/*.rs",
    "grammar.js",
    "pyproject.toml",
    "queries/*.scm",
    "setup.py",
    "src/*.c",
    "src/*.json",
    "src/tree_sitter/*.h",
    "test/bindings.test.rs",
    "tree-sitter.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node-gyp rebuild && node-gyp configure -- -f compile_commands_json",
    "build:parser": "npm run tree-sitter -- build-all",
    "check": "biome check . && tsc",
    "check:queries": "npm run tree-sitter -- check-queries",
    "format": "biome format --write .",
    "generate": "npm run tree-sitter -- generate-all",
    "install": "node-gyp-build",
    "test": "npm run tree-sitter -- test-corpus --rebuild && node --test --test-concurrency=1 test/bindings.test.js test/build.test.js test/cst.test.js test/highlight.test.js test/incremental.test.js test/parser.test.js && node scripts/check-c.js --test",
    "test:fuzz": "npm run tree-sitter -- fuzz-all --iterations 100 --edits 5",
    "test:sanitize": "node scripts/check-c.js --sanitize",
    "tree-sitter": "node scripts/tree-sitter.js"
  },
  "dependencies": {
    "node-addon-api": "8.9.2",
    "node-gyp-build": "4.8.4"
  },
  "peerDependencies": {
    "tree-sitter": "0.25.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "node-gyp": "13.1.0",
    "tree-sitter-cli": "0.27.1",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "tree-sitter": true,
    "tree-sitter-cli": true
  }
}
