{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "mailmap",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "mapping"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          },
          {
            "type": "SYMBOL",
            "name": "blank_line"
          }
        ]
      }
    },
    "mapping": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_simple_mapping_start"
                },
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "FIELD",
                      "name": "canonical_name",
                      "content": {
                        "type": "SYMBOL",
                        "name": "name"
                      }
                    },
                    {
                      "type": "SYMBOL",
                      "name": "_name_separator"
                    }
                  ]
                },
                {
                  "type": "FIELD",
                  "name": "commit_email",
                  "content": {
                    "type": "SYMBOL",
                    "name": "email"
                  }
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_paired_mapping_start"
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SEQ",
                      "members": [
                        {
                          "type": "FIELD",
                          "name": "canonical_name",
                          "content": {
                            "type": "SYMBOL",
                            "name": "name"
                          }
                        },
                        {
                          "type": "SYMBOL",
                          "name": "_name_separator"
                        }
                      ]
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                },
                {
                  "type": "FIELD",
                  "name": "canonical_email",
                  "content": {
                    "type": "SYMBOL",
                    "name": "email"
                  }
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SEQ",
                      "members": [
                        {
                          "type": "FIELD",
                          "name": "commit_name",
                          "content": {
                            "type": "SYMBOL",
                            "name": "name"
                          }
                        },
                        {
                          "type": "SYMBOL",
                          "name": "_name_separator"
                        }
                      ]
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                },
                {
                  "type": "FIELD",
                  "name": "commit_email",
                  "content": {
                    "type": "SYMBOL",
                    "name": "email"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_comment"
                },
                "named": true,
                "value": "comment"
              },
              {
                "type": "SYMBOL",
                "name": "ignored_suffix"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_ending"
        }
      ]
    },
    "name": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_name_start"
        },
        {
          "type": "SYMBOL",
          "name": "name_text"
        },
        {
          "type": "SYMBOL",
          "name": "_name_end"
        }
      ]
    },
    "email": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opening",
          "content": {
            "type": "SYMBOL",
            "name": "email_open"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "email_text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "closing",
          "content": {
            "type": "SYMBOL",
            "name": "email_close"
          }
        }
      ]
    },
    "_comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_comment_start"
        },
        {
          "type": "SYMBOL",
          "name": "comment_marker"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "comment_text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_comment_end"
        }
      ]
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_comment_line_start"
        },
        {
          "type": "SYMBOL",
          "name": "_comment"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "ignored_suffix"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_ending"
        }
      ]
    },
    "ignored_suffix": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_ignored_start"
        },
        {
          "type": "SYMBOL",
          "name": "ignored_text"
        },
        {
          "type": "SYMBOL",
          "name": "_ignored_end"
        }
      ]
    },
    "blank_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_blank_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "ignored_suffix"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_ending"
        }
      ]
    },
    "_ending": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "line_ending"
        },
        {
          "type": "SYMBOL",
          "name": "_eof"
        }
      ]
    },
    "_unmatchable": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "[\\s\\S]"
          },
          {
            "type": "PATTERN",
            "value": "[^\\s\\S]"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "SYMBOL",
      "name": "_line_start"
    },
    {
      "type": "SYMBOL",
      "name": "_layout"
    },
    {
      "type": "SYMBOL",
      "name": "_unmatchable"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
