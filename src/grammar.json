    },
    {
      "type": "SYMBOL",
      "name": "_name_start"
    },
    {
      "type": "SYMBOL",
      "name": "_name_end"
    },
    {
      "type": "SYMBOL",
      "name": "_name_separator"
    },
    {
      "type": "SYMBOL",
      "name": "_comment_start"
    },
    {
      "type": "SYMBOL",
      "name": "_comment_end"
    },
    {
      "type": "SYMBOL",
      "name": "_ignored_start"
    },
    {
      "type": "SYMBOL",
      "name": "_ignored_end"
    },
    {
      "type": "SYMBOL",
      "name": "_layout"
    },
    {
      "type": "SYMBOL",
      "name": "_eof"
    },
    {
      "type": "SYMBOL",
      "name": "line_ending"
    },
    {
      "type": "SYMBOL",
      "name": "name_text"
    },
    {
      "type": "SYMBOL",
      "name": "email_open"
    },
    {
      "type": "SYMBOL",
      "name": "email_text"
    },
    {
      "type": "SYMBOL",
      "name": "email_close"
    },
    {
      "type": "SYMBOL",
      "name": "comment_marker"
    },
    {
      "type": "SYMBOL",
      "name": "comment_text"
    },
    {
      "type": "SYMBOL",
      "name": "ignored_text"
    },
    {
      "type": "SYMBOL",
      "name": "_error_sentinel"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}